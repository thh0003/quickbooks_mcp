# Copy to .env and fill in. .env is gitignored.

# From the Intuit Developer portal: your app -> Keys & credentials.
# Use the Development (sandbox) keys while QBO_ENVIRONMENT=sandbox.
QBO_CLIENT_ID=your-client-id
QBO_CLIENT_SECRET=your-client-secret

# sandbox (default) or production. Tokens are stored per environment.
QBO_ENVIRONMENT=sandbox

# Must be registered as a redirect URI on the app's Keys & credentials page.
QBO_REDIRECT_URI=http://localhost:8765/callback

# Where tokens are saved. Default: ~/.qbo_mcp/tokens-<environment>.json
# QBO_TOKEN_PATH=/absolute/path/tokens-sandbox.json
